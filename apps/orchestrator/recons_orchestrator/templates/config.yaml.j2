# Hermes Agent config for "{{ record.name }}" ({{ record.id }})
#
# GENERATED AND OWNED BY THE ORCHESTRATOR — do not hand-edit; changes are
# overwritten whenever the agent roster changes. Edit SOUL.md (persona) or the
# shared config instead. Every key marked VERIFY should be checked against
# https://hermes-agent.nousresearch.com/docs for the installed Hermes version
# before you rely on it.

# --- Identity -----------------------------------------------------------------
soul_file: SOUL.md   # VERIFY key name (persona/identity file)

# --- Model + failover ---------------------------------------------------------
# Providers themselves (api keys / OAuth) are configured once at the shared
# level; here we only pick this agent's model and its fallback chain.
model:
  provider: {{ tier.provider }}
  default: {{ tier.model }}
{% if custom_provider %}# Operator-added OpenAI-compatible provider (Customize tab). The key rides in
# via ${ENV} from shared secrets.env (the unit's EnvironmentFile) — the value
# is never written into this file. VERIFY the providers block shape and that
# Hermes expands ${ENV} for api_key.
providers:
  {{ custom_provider.id }}:
    type: openai-compatible           # VERIFY provider type id
    base_url: "{{ custom_provider.base_url }}"
    api_key: "${{ '{' }}{{ custom_provider.key_env }}}"
{% endif %}{% if tier.fallbacks %}fallback_providers:                   # VERIFY key name
{% for fb in tier.fallbacks %}  - {{ fb }}
{% endfor %}{% endif %}

# --- Shared skills ------------------------------------------------------------
# All agents read the same shared skill library so a skill taught to one is
# usable by all. Agent-authored skills are staged for human approval.
skills:
  external_dirs:                      # VERIFY key name
    - {{ shared_skills_dir }}
  write_approval: true                # agent-created skills need human approval
  guard_agent_created: true           # scan agent-authored skill content

# --- Safety -------------------------------------------------------------------
approvals:
  mode: smart                         # LLM risk-scores actions; never "off"
terminal:
  backend: docker                     # sandbox tool execution on the VPS
  # VERIFY docker limit keys; keep cap-drop ALL + resource limits (see docs/60)

# --- Tool exposure ------------------------------------------------------------
# The outbound A2A tools (a2a_list, a2a_discover, a2a_call, a2a_history,
# a2a_orchestrate) live in the plugin toolset "a2a", which Hermes ships
# DEFAULT-OFF (hermes_cli/tools_config.py _DEFAULT_OFF_TOOLSETS). The gateway
# block below only serves *inbound* A2A — without this list an agent shows as
# "A2A connected" yet has zero a2a_* tools in its manifest.
#
# Verified against hermes-agent source: an explicit list replaces the
# platform's default entirely, so it must restate the platform composite
# (hermes-cli / hermes-telegram) alongside "a2a"; explicitly listed toolsets
# survive the default-off filter (upstream #81163). Dashboard chat runs
# `hermes -z`, which resolves tools for the "cli" platform. The "a2a"
# platform must NOT get an entry here: it already exempts its own toolset by
# default, and its composite (hermes-a2a) is registry-generated rather than a
# static toolset, so an explicit list would silently drop the core tools.
platform_toolsets:
  cli: [hermes-cli, a2a]
{% if record.telegram_enabled %}  telegram: [hermes-telegram, a2a]
{% endif %}

# --- Agent-to-agent (A2A) -----------------------------------------------------
# This agent's inbound A2A server. The bearer tokens peers must present live in
# service.env (A2A_PEER_TOKENS), not here. Bound to loopback; reachable only
# over the tailnet. With A2A_PEER_TOKENS set, Hermes rejects tokenless inbound
# requests with 401 (verified: plugins/platforms/a2a/security.py authenticate).
gateway:
  platforms:
    a2a:
      enabled: true
      extra:
        port: {{ record.a2a_port }}
        host: 127.0.0.1               # VERIFY host key; remote reach via tailscale
{% if record.telegram_enabled %}    telegram:
      enabled: true                   # VERIFY platform id + key names (docs/30)
      extra:
        # Placeholder only — the real token is re-emitted into service.env
        # (TELEGRAM_BOT_TOKEN) by the mesh; the allowlist is enforced via the
        # TELEGRAM_ALLOWED_USERS env there. VERIFY that Hermes expands ${ENV}.
        bot_token: "${TELEGRAM_BOT_TOKEN}"
{% endif %}

# Outbound peers this agent may call (the mesh). Tokens are injected from
# service.env so no secret is written into this file.
a2a_agents:
{% for peer in peers %}  {{ peer.id }}:
    url: "http://127.0.0.1:{{ peer.a2a_port }}"
    auth:
      type: bearer
      token: "${A2A_TOKEN_{{ peer.id | upper | replace('-', '_') }}}"   # from service.env
    capabilities: [chat, terminal, files]   # free-form labels; a2a_orchestrate matches on them
{% endfor %}{% if not peers %}  {}
{% endif %}

# --- Audit feed ---------------------------------------------------------------
# Every lifecycle event is POSTed (HMAC-signed) to the orchestrator's ledger so
# the dashboard's Audit tab has a live feed in addition to on-disk transcripts.
webhooks:                             # VERIFY block/key names
  outbound:
    - url: "{{ webhook_receiver_url }}"
      secret: "${{ '{' }}{{ webhook_secret_env }}}"
      events: [pre_tool_call, post_tool_call, on_session_start, on_session_end, subagent_start, subagent_stop]
