# Shared secrets for ALL agents. Copy to /opt/recons/shared/secrets.env and
# chmod 600. Never commit the real file.
#
# Every agent reads this one file, so a key added here is immediately usable by
# the whole team — that is the "shared API keys" behaviour, without copies
# scattered per agent.

# --- Claude (lead agent only) -------------------------------------------------
# Route A (default, what this kit assumes): the claude-code-openai-wrapper runs
# locally against your logged-in Claude CLI, exposing an OpenAI-compatible
# endpoint. Nothing to put here except the wrapper's local address.
#   See docs/40-providers-and-tos.md for the honest ToS position.
CLAUDE_WRAPPER_BASE_URL=http://127.0.0.1:8600/v1
CLAUDE_WRAPPER_API_KEY=not-used-locally

# Route B (the one-line fallback): a Claude Console API key. Uncomment this and
# switch the lead agent's provider to `anthropic` if Anthropic's Agent SDK
# billing change comes off pause, or if you simply prefer pay-as-you-go.
# ANTHROPIC_API_KEY=

# --- OpenAI / ChatGPT subscription (the workhorse) ----------------------------
# Preferred: run `hermes model` and pick "ChatGPT or Codex Subscription" — the
# OAuth token is stored in the agent's auth.json, not here.
# Only set this if you are using a pay-as-you-go API key instead:
# OPENAI_API_KEY=

# --- Nous Portal (cheap bulk + auxiliary tasks) -------------------------------
NOUS_API_KEY=

# --- Orchestrator -------------------------------------------------------------
# Shared secret Hermes signs its outbound lifecycle webhooks with; the
# orchestrator verifies every delivery against it. Generate with:
#   openssl rand -hex 32
RECONS_WEBHOOK_SECRET=

# Operator login for the dashboard (bcrypt hash, not the password itself).
RECONS_OPERATOR_USER=tony
RECONS_OPERATOR_PASSWORD_HASH=
