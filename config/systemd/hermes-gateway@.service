# One Hermes gateway per agent. `%i` is the agent id, so enabling
# hermes-gateway@scout starts the agent whose HERMES_HOME is
# /opt/recons/agents/scout/home. The orchestrator enables/stops these when you
# create, pause or delete an agent in the dashboard.
#
# vps-bootstrap.sh installs this in whichever systemd scope suits the account:
# user scope (~/.config/systemd/user/, needs `loginctl enable-linger $USER` to
# survive logout) for a normal user, or system scope (/etc/systemd/system/) when
# running as root, which has no user-level systemd instance.
[Unit]
Description=Hermes agent gateway (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Shared secrets first, then the per-agent env (HERMES_HOME, A2A tokens).
EnvironmentFile=/opt/recons/shared/secrets.env
EnvironmentFile=/opt/recons/agents/%i/service.env
# Resolve hermes from PATH rather than hardcoding a location: the installer
# puts it in /usr/local/bin for a system-wide install and ~/.local/bin for a
# per-user one, and %h would point at the wrong place in system scope.
ExecStart=/usr/bin/env hermes gateway
Restart=on-failure
RestartSec=5

# Hardening: the gateway needs its own state, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ReadWritePaths=/opt/recons/agents/%i /opt/recons/shared

[Install]
WantedBy=default.target
